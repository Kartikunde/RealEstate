generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  AGRICULTURAL_LAND
  RESIDENTIAL_PLOT
  COMMERCIAL_PLOT
}

enum AreaUnit {
  SQFT
  SQYD
  ACRE
  SQM
}

enum PropertyStatus {
  OWNED
  RENTED
  VACANT
  UNDER_MAINTENANCE
  SOLD
}

enum FinancialType {
  INCOME
  EXPENSE
}

enum FinancialCategory {
  RENTAL_INCOME
  PROPERTY_SALE
  OTHER_INCOME
  MAINTENANCE
  PROPERTY_TAX
  INSURANCE
  REPAIRS
  SOCIETY_CHARGES
  UTILITIES
  MANAGEMENT_FEES
  OTHER_EXPENSES
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
  PARTIALLY_PAID
}

enum TransactionType {
  PROPERTY_PURCHASE
  PROPERTY_SALE
  RENTAL_INCOME
  MAINTENANCE_EXPENSE
  PROPERTY_TAX
  LOAN_PAYMENT
  OTHER
}

enum DocumentCategory {
  SALE_DEED
  RENTAL_AGREEMENT
  PROPERTY_TAX_RECEIPT
  INSURANCE_DOC
  MAINTENANCE_RECEIPT
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
}

model User {
  id            String            @id @default(uuid())
  email         String            @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role              @default(USER)
  avatarUrl     String?
  properties    Property[]
  financials    FinancialRecord[]
  loans         Loan[]
  transactions  Transaction[]
  watchlist     Watchlist[]
  notifications Notification[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Property {
  id                  String             @id @default(uuid())
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  type                PropertyType
  description         String?            @db.Text
  address             String
  city                String
  state               String
  pinCode             String
  latitude            Float?
  longitude           Float?
  purchasePrice       Float
  currentValuation    Float
  area                Float
  areaUnit            AreaUnit           @default(SQFT)
  bedrooms            Int?               @default(0)
  bathrooms           Int?               @default(0)
  purchaseDate        DateTime
  status              PropertyStatus     @default(OWNED)
  monthlyRentalIncome Float?             @default(0)
  imageUrl            String?
  documentsJson       String?            @db.Text
  agreements          RentalAgreement[]
  financialRecords    FinancialRecord[]
  loans               Loan[]
  transactions        Transaction[]
  documents           PropertyDocument[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model MarketplaceListing {
  id                          String       @id @default(uuid())
  title                       String
  type                        PropertyType
  description                 String       @db.Text
  address                     String
  city                        String
  state                       String
  pinCode                     String
  latitude                    Float?
  longitude                   Float?
  price                       Float
  area                        Float
  areaUnit                    AreaUnit     @default(SQFT)
  bedrooms                    Int?         @default(0)
  bathrooms                   Int?         @default(0)
  estimatedRentalIncome       Float
  estimatedRentalYield        Float
  estimatedAnnualAppreciation Float
  imageUrl                    String
  imageGallery                String?      @db.Text
  specifications              String?      @db.Text
  sellerName                  String
  sellerPhone                 String
  sellerEmail                 String
  isDemo                      Boolean      @default(true)
  watchlistEntries            Watchlist[]
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
}

model Watchlist {
  id        String             @id @default(uuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([userId, listingId])
}

model RentalAgreement {
  id              String          @id @default(uuid())
  propertyId      String
  property        Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenantName      String
  tenantEmail     String?
  tenantPhone     String
  monthlyRent     Float
  securityDeposit Float           @default(0)
  startDate       DateTime
  endDate         DateTime
  paymentDueDate  Int             @default(5)
  status          String          @default("ACTIVE")
  notes           String?         @db.Text
  payments        RentalPayment[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model RentalPayment {
  id            String          @id @default(uuid())
  agreementId   String
  agreement     RentalAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  propertyId    String
  amount        Float
  dueDate       DateTime
  paymentDate   DateTime?
  status        PaymentStatus   @default(PENDING)
  paymentMethod String?
  receiptUrl    String?
  notes         String?
  createdAt     DateTime        @default(now())
}

model FinancialRecord {
  id              String            @id @default(uuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String?
  property        Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  type            FinancialType
  category        FinancialCategory
  amount          Float
  transactionDate DateTime
  description     String?
  receiptUrl      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Loan {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId         String
  property           Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bankName           String
  principalAmount    Float
  interestRate       Float
  tenureMonths       Int
  startDate          DateTime
  emiAmount          Float
  outstandingBalance Float
  notes              String?
  emiPayments        LoanEmiPayment[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model LoanEmiPayment {
  id               String   @id @default(uuid())
  loanId           String
  loan             Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  paymentDate      DateTime
  amountPaid       Float
  principalPaid    Float
  interestPaid     Float
  remainingBalance Float
  status           String   @default("PAID")
  notes            String?
  createdAt        DateTime @default(now())
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId      String?
  property        Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  type            TransactionType
  amount          Float
  date            DateTime
  description     String
  paymentMethod   String?
  referenceNumber String?
  createdAt       DateTime        @default(now())
}

model PropertyDocument {
  id         String           @id @default(uuid())
  propertyId String
  property   Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title      String
  category   DocumentCategory @default(OTHER)
  fileUrl    String
  fileSize   String?
  uploadedAt DateTime         @default(now())
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
}
