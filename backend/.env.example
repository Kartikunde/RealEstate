# PropVest Environment Configuration Template
# Duplicate this file to .env and configure your local PostgreSQL database credentials.

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/propvest_db?schema=public"
JWT_SECRET="your_strong_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:4200"
UPLOAD_DIR="./uploads"
